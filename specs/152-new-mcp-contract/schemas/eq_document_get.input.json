{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgequake.dev/schemas/eq-mcp-1.0/eq_document_get.input.json",
  "title": "eq_document_get input",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id"],
  "properties": {
    "document_id": { "type": "string", "minLength": 1 },
    "include": {
      "type": "array",
      "items": { "enum": ["metadata", "outline", "text", "assets"] },
      "default": ["metadata"],
      "description": "text returns text_page (offset/limit/total_chars) plus optional eq:// resource; assets = metadata only"
    },
    "text_offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "SPEC-162: character offset into document text"
    },
    "text_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32000,
      "default": 8000,
      "description": "SPEC-162: max characters in text_page"
    },
    "workspace_id": {
      "type": "string",
      "x-mcp-header": "Workspace-Id"
    },
    "budget": {
      "type": "string",
      "enum": ["cheap", "standard", "deep"],
      "default": "standard"
    }
  }
}
