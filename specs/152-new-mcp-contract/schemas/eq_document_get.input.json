{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgequake.dev/schemas/eq-mcp-1.0/eq_document_get.input.json",
  "title": "eq_document_get input",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id"],
  "properties": {
    "document_id": { "type": "string", "minLength": 1 },
    "include": {
      "type": "array",
      "items": { "enum": ["metadata", "outline", "text", "assets"] },
      "default": ["metadata"],
      "description": "assets = metadata only (ids, kind, page, media_type, byte_length); use eq_asset_get for pixels"
    },
    "workspace_id": {
      "type": "string",
      "x-mcp-header": "Workspace-Id"
    },
    "budget": {
      "type": "string",
      "enum": ["cheap", "standard", "deep"],
      "default": "standard"
    }
  }
}
